# Application
APP_NAME=LinkPulse URL Analytics
ENVIRONMENT=development
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MySQL (Docker Compose defaults)
DATABASE_URL=mysql+pymysql://linkpulse:linkpulse_dev_password@mysql:3306/linkpulse

# Redis is used for distributed rate limiting and the Celery broker
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1
RATE_LIMIT_FAIL_OPEN=true

# Optional MaxMind GeoLite2 City database file (download separately; do not commit it)
GEOIP_DB_PATH=

# Optional S3 export destination; leave empty for local CSV export
S3_BUCKET=
AWS_REGION=ap-south-1
